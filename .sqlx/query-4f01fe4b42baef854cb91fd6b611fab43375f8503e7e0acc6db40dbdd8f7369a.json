  "query": "\n        SELECT id, identifier, provider_type as \"provider_type: ProviderType\", hash, expires_at, verified_at, created_at, ip_address, failed_attempts\n        FROM \"otp\"\n        WHERE identifier = $1 AND provider_type = $2\n        ORDER BY created_at DESC\n        LIMIT 1\n        ",
